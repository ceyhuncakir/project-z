# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
VITE_SERVER_URL=

# The public website: landing page, catalog and docs (the hessianlabs-ai/landing
# repo). The logo on sign-in pages and the dashboard's Docs links go there.
# @public @type=url
VITE_SITE_URL=

# Where server-side rendering reaches the API when VITE_SERVER_URL isn't
# reachable from the web server, e.g. http://server:3000 inside Docker.
# @optional @public @dynamic @type=url
INTERNAL_SERVER_URL=
