# Copy to .env. Every variable is documented in .env.schema.
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/switchyard

# Free test credits button in the dashboard (ignored in production).
ALLOW_TEST_CREDITS=true

# Payments (optional) — Polar product with a "pay what you want" price.
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_CREDITS_PRODUCT_ID=
# POLAR_SERVER=sandbox

# Providers without credentials run in sandbox mode.
# HETZNER_API_TOKEN=
# DIGITALOCEAN_TOKEN=
# VULTR_API_KEY=
# LINODE_TOKEN=
# SCW_SECRET_KEY=
# SCW_PROJECT_ID=
# OVH_ENDPOINT=ovh-eu
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=
# OVH_PROJECT_ID=
