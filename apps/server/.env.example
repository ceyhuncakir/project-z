# Copy to .env. Every variable is documented in .env.schema.
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/switchyard
# Seals users' cloud credentials: openssl rand -base64 32
CREDENTIALS_KEY=

# Only for deploy/docker-compose.yml: its Postgres (localhost:5433, user and
# database switchyard) gets this password. openssl rand -hex 24
# POSTGRES_PASSWORD=

# Free test credits button in the dashboard (ignored in production).
ALLOW_TEST_CREDITS=true

# Payments (optional): Stripe secret key + webhook signing secret.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Simulate every provider while developing: any token "connects" and servers are fake.
CLOUD_SANDBOX_ONLY=true

# Read-only tokens for price lists. Servers use each user's own account.
# HETZNER_API_TOKEN=
# DIGITALOCEAN_TOKEN=
# VULTR_API_KEY=
# LINODE_TOKEN=
# SCW_SECRET_KEY=
# SCW_PROJECT_ID=
# OVH_ENDPOINT=ovh-eu
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=
# OVH_PROJECT_ID=
