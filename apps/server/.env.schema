# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Public URL of this API server (auth, RPC, REST and the /mcp endpoint).
# @public @type=url
BETTER_AUTH_URL=

# Public URL of the web app. Used for CORS and links in emails/checkout.
# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Seals users' cloud credentials in the database (AES-256-GCM).
# 32 random bytes, base64: openssl rand -base64 32. Losing it means every user
# has to reconnect their accounts; keep a copy somewhere safe.
# @type=string(minLength=44)
CREDENTIALS_KEY=

# HessianLabs's fee, as a percentage of each server's list price. Applies to
# servers created after a change; running ones keep the rate they started with.
# @public @type=number
PLATFORM_FEE_PERCENT=5

# --- Payments (Stripe). Leave empty to run without card payments. ---

# Secret key, sk_test_… or sk_live_…
# @optional @type=string(startsWith=sk_)
STRIPE_SECRET_KEY=

# Signing secret of the webhook endpoint pointing at /webhooks/stripe (whsec_…)
# @optional @type=string(startsWith=whsec_)
STRIPE_WEBHOOK_SECRET=

# Lets signed-in users add free test credits. Never enable in production.
# @public @type=boolean
ALLOW_TEST_CREDITS=false

# --- Social login (optional) ---

# @optional @public
GITHUB_CLIENT_ID=

# @optional
GITHUB_CLIENT_SECRET=

# --- Cloud providers ---
# Servers are created in each user's own account. The tokens below are only
# used to read price lists: give them read-only access, and keep no servers
# there. A provider without one serves its reference price list.

# Simulate every provider: users can "connect" any account with any token and
# servers are fake. For local development and demos; refused in production.
# @public @type=boolean
CLOUD_SANDBOX_ONLY=false

# @public @type=number
SANDBOX_BOOT_SECONDS=12

# @public @type=number
EUR_USD_RATE=1.1

# @optional
HETZNER_API_TOKEN=

# @optional
DIGITALOCEAN_TOKEN=

# @optional
VULTR_API_KEY=

# @optional
LINODE_TOKEN=

# @optional
SCW_SECRET_KEY=

# @optional @public
SCW_PROJECT_ID=

# @optional @public @type=enum(ovh-eu, ovh-ca, ovh-us)
OVH_ENDPOINT=

# @optional
OVH_APPLICATION_KEY=

# @optional
OVH_APPLICATION_SECRET=

# @optional
OVH_CONSUMER_KEY=

# @optional @public
OVH_PROJECT_ID=
