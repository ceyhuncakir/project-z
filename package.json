{
	"name": "switchyard",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.2",
			"varlock": "1.18.0",
			"@orpc/server": "^1.15.6",
			"@orpc/openapi": "^1.15.6",
			"@orpc/zod": "^1.15.6",
			"better-auth": "1.7.7",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.8",
			"tailwindcss": "^4.3.3",
			"@orpc/client": "^1.15.6",
			"drizzle-orm": "1.0.0-rc.4"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"db:push": "turbo run db:push -F @switchyard/db --",
		"db:studio": "turbo run db:studio -F @switchyard/db --",
		"db:generate": "turbo run db:generate -F @switchyard/db --",
		"db:migrate": "turbo run db:migrate -F @switchyard/db --",
		"db:start": "turbo run db:start -F @switchyard/db --",
		"db:watch": "turbo run db:watch -F @switchyard/db --",
		"db:stop": "turbo run db:stop -F @switchyard/db --",
		"db:down": "turbo run db:down -F @switchyard/db --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/server && bun run auth:generate",
		"check": "biome check --write .",
		"test": "turbo run test"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@switchyard/config": "workspace:*",
		"@types/bun": "catalog:",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.4.2"
}
